# Copy this file to .env for local development against a real Supabase project,
# or add the same keys in Vercel (Project Settings -> Environment Variables) for
# production. Never commit real values — .env is gitignored.
#
# With NO .env file the app runs in local offline mock mode (no Supabase/Google).

# Supabase — used by the frontend (Vite inlines VITE_* at build time) and,
# on Vercel, also readable by the api/*.js serverless functions.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Server-only: full-access key used by the api/*.js serverless functions.
# Never expose this to the browser or prefix it with VITE_/NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google sign-in is configured in the Supabase dashboard (Auth -> Providers -> Google),
# not via env vars here.
